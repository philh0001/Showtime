{
  "name": "mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/ui": "~57.0.18",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.22",
    "expo-constants": "~57.0.18",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.21",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "test": "node --no-warnings=ExperimentalWarning --experimental-strip-types --test tests/*.test.mjs server/*.test.mjs",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "search:tmdb": "node ./scripts/search-tmdb.mjs",
    "search:server": "node ./server/start.mjs",
    "test:search": "node --test server/search.test.mjs server/details.test.mjs",
    "test:history": "node --no-warnings=ExperimentalWarning --experimental-strip-types --test tests/search-history-rules.test.mjs",
    "test:watchlist": "node --no-warnings=ExperimentalWarning --experimental-strip-types --test tests/watchlist-rules.test.mjs",
    "test:tracking": "node --no-warnings=ExperimentalWarning --experimental-strip-types --test tests/air-date-rules.test.mjs tests/tv-progress-rules.test.mjs tests/watchlist-progress.test.mjs",
    "test:home": "node --no-warnings=ExperimentalWarning --experimental-strip-types --test tests/recently-viewed-rules.test.mjs tests/home-data.test.mjs tests/continue-watching.test.mjs",
    "test:movies": "node --no-warnings=ExperimentalWarning --experimental-strip-types --test tests/movie-progress-rules.test.mjs",
    "security:scan": "node scripts/scan-secrets.mjs --tracked . --generated dist ../worker/worker-dist",
    "worker:release-check": "npm run lint && npx tsc --noEmit && npm test && npm --prefix ../worker run check && npm --prefix ../worker run bundle && npm audit --audit-level=high && npm run security:scan"
  },
  "private": true
}

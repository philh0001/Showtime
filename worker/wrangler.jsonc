{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "showtime-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-15",
  "workers_dev": true,
  "preview_urls": false,
  // Browser access is restricted to the deployed Showtime frontend.
  "vars": {
    "ALLOWED_ORIGINS": "https://showtimetracker.show",
    "EMAIL_FROM": "Showtime <noreply@showtimetracker.show>",
    "APP_NAME": "Showtime",
    "APP_URL": "https://showtimetracker.show",
    "RESEND_VERIFICATION_TEMPLATE_ID": "92d2a801-c7fb-4030-bba0-5e70c1d697ac"
  },
  // `RESEND_API_KEY` is a Worker secret, uploaded with
  // `wrangler secret put RESEND_API_KEY`; do not put it in this file.
  "ratelimits": [
    { "name": "SEARCH_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    { "name": "DISCOVERY_LIMITER", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } },
    { "name": "DETAILS_LIMITER", "namespace_id": "1003", "simple": { "limit": 20, "period": 60 } },
    { "name": "WORK_LIMITER", "namespace_id": "1004", "simple": { "limit": 100, "period": 60 } },
    { "name": "AUTH_LIMITER", "namespace_id": "1005", "simple": { "limit": 10, "period": 60 } },
    { "name": "SYNC_LIMITER", "namespace_id": "1006", "simple": { "limit": 60, "period": 60 } }
  ],
  "d1_databases": [
    { "binding": "SHOWTIME_DB", "database_name": "showtime-db", "database_id": "26791329-ad1c-44f3-bcbd-c0340c979e41" }
  ],
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": false }
  }
}

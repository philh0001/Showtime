{
  "name": "showtime-api-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "types": "wrangler types src/worker-configuration.d.ts",
    "api:test": "node --test src/api/*.test.mjs",
    "test": "vitest --config vitest.config.ts --exclude \"src/api/*.test.mjs\"",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "check": "npm run api:test && npm run types && npm run typecheck && npm test -- --run",
    "bundle": "wrangler deploy --dry-run --outdir worker-dist",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.1.10",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "wrangler": "4.132.0"
  }
}

{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "showtime-web",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-16",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  }
}
